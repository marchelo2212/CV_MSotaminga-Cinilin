@article{apolo-buenanoUsosInternetCon2023,
  title = {Usos de Internet con fines educativos: perspectivas para su fortalecimiento},
  shorttitle = {Usos de Internet con fines educativos},
  author = {Apolo-Buena\~no, Diego Eduardo and Hermann-Acosta, Ernesto Andr\'es and Garc\'ia-Herrera, Darwin Gabriel and Sotaminga-Cinilin, Marcelo Javier},
  date = {2023-01-10},
  journaltitle = {Revista Conrado},
  volume = {19},
  number = {90},
  pages = {233--236},
  issn = {1990-8644},
  url = {https://conrado.ucf.edu.cu/index.php/conrado/article/view/2887},
  urldate = {2025-07-27},
  abstract = {El desarrollo de las tecnolog\'ias ha permitido un avance vertiginoso en la sociedad; lamentablemente, en los campos educativos no han tenido un acompa\~namiento para su comprensi\'on desde un enfoque sociocr\'itico, centr\'andose principalmente en el enfoque artefactual priorizando dispositivos y conexiones. Es as\'i que en este texto se presentan algunas l\'ineas que permitan analizar los diferentes procesos que podr\'ia aportar a una aproximaci\'on desde el uso educativo de plataformas digitales y redes sociales, en el desarrollo se evidencia varios aspectos a tomar en consideraci\'on como lo pedagogo, metodol\'ogico y evaluativo base fundamental para la generaci\'on de un interaprendizaje de calidad en Educaci\'on Superior. Palabras clave: Usos educativos de internet, educaci\'on, internet, Educaci\'on Superior. \&nbsp; ABSTRACT The development of technologies has allowed a vertiginous advance in society; unfortunately, in the educational fields they have not had an accompaniment for their understanding from a sociocritical approach, focusing mainly on the artifactual approach prioritizing devices and connections. Thus, in this text some lines are presented that allow analyzing the different processes that could contribute to an approach from the educational use of digital platforms and social networks; In the development, several aspects to be taken into consideration are evident, such as the pedagogical, methodological and evaluative fundamental base for the generation of a quality inter-learning in Higher Education. Keywords: Educational uses of the internet, education, Internet, Higher education. \&nbsp;},
  issue = {90},
  langid = {spanish},
  keywords = {No DOI found},
  file = {/Users/marcelosotaminga/Nextcloud/Zotero/z-mac-mho2212/storage/9Y4YEEE7/Apolo-Buenaño et al. - 2023 - Usos de Internet con fines educativos perspectivas para su fortalecimiento.pdf}
}

